# ================================================================
# SpaceToStudy Client — Build-time Environment Variables
# Copy to .env and fill in before running: make up (dev Docker, Vite + HMR)
# For a production-like build use: make prod-up
# In dev Docker, VITE_* changes are picked up on restart; the prod build embeds
# VITE_* at build time, so re-run make prod-up after changing them.
#
# WARNING:
# Every VITE_* value is embedded into the public browser bundle.
# Do not put private secrets here — treat all values as public.
# ================================================================

# Backend API URL — вбудовується у JS bundle під час збірки
# Без Traefik:
VITE_API_BASE_PATH=http://localhost:3000
# Client буде доступний на http://localhost:8090
# З Traefik (бекенд монтує роути без префікса /api):
# VITE_API_BASE_PATH=https://s2s-api.docker.localhost

# Google OAuth2 Client ID (для Google Sign-In)
VITE_GMAIL_CLIENT_ID=

# Azure Blob Storage — URL для зображень
VITE_APP_IMG_URL=
VITE_APP_IMG_USER_URL=

# TinyMCE (Rich Text Editor)
VITE_APP_TINY_MCE_API_KEY=
